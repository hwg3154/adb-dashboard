# tvdashboard environment.
# Copy to `.env` (in the same directory as docker-compose.yml) and edit.
# docker compose reads this file automatically for `${VAR}` substitution and exports nothing
# to the host; the container only ever sees the `environment:` values.
#
#   cp .env.example .env && nano .env

# --- Listen ---------------------------------------------------------------------
# Address the HTTP server binds. Host networking (see docker-compose.yml) means this is the
# LAN address; change the port if 8080 is taken.
TVD_HTTP_ADDR=0.0.0.0:8080
# 1 = serve plain HTTP without the browser warning banner, and without the `Secure` cookie flag.
TVD_ALLOW_INSECURE_HTTP=1

# --- Scriptable API (optional) ---------------------------------------------------
# A long random string here turns on the token API: any POST with
#   Authorization: Bearer <TVD_API_KEY>
# works with no session cookie, CSRF token, or Origin header - the way a script, n8n node, or
# the agent is supposed to call it. Leave EMPTY to keep the API off (browser-only, as before).
# Minimum 16 characters; 32+ random is recommended. Generate one with:
#   openssl rand -hex 32
# NEVER commit a filled-in .env; it already is, and the key grants full TV control.
TVD_API_KEY=

# --- Discovery / targets ---------------------------------------------------------
# Comma-separated private CIDRs the dashboard may sweep and connect to. Default is all of RFC1918.
# TVD_ALLOWED_CIDRS=192.168.12.0/24
# adb ports the discovery sweep probes. Default 5555,5556,5557.
# TVD_DEVICE_PORTS=5555,5556,5557
# Path to the adb binary inside the container. Default adb (Debian package in the image).
# TVD_ADB_BIN=adb

# --- State -----------------------------------------------------------------------
# docker compose mounts named volumes for /data and the adb key, so TVD_DATA_DIR is not needed
# in the container. Set it only when running `python3 -m tvdashboard` directly:
# TVD_DATA_DIR=./var
