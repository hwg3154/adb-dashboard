# --- Runtime data (TVD_DATA_DIR) -------------------------------------------
# These hold password hashes, live session tokens and paired-device records.
# Never commit them, wherever the data dir happens to point.
/var/
/data/
accounts.json
sessions.json
devices.json
prefs.json

